  "license": "MIT",
  "homepage": "https://tryquickdraw.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmndwivedi/quickdraw.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/nmndwivedi/quickdraw/issues",
  "publishConfig": {
    "access": "public"
  }
